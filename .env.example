# ============================================================
# 杯子音乐网 - 环境变量配置模板
# 使用：复制本文件为 .env 后按需修改（.env 不会提交到 Git）
#       没有 .env 时程序用各配置项的默认值运行，但爬虫需要 PHPSESSID
# ============================================================

# ---- Django 核心 ----
# 密钥：生产环境请更换为随机值
SECRET_KEY=django-insecure-change-me-to-your-own-random-key
# 调试模式：True 会显示详细报错，生产环境请保持 False
DEBUG=False
# 允许访问的域名，逗号分隔（生产环境填真实域名）
ALLOWED_HOSTS=127.0.0.1
CORS_ORIGIN_ALLOW_ALL=True
# 站点跑在 HTTPS 反向代理（Nginx/CDN）后面时设为 True：
# 让 Django 信任 X-Forwarded-Proto 头，否则 canonical / og:url / sitemap.xml / robots.txt
# 里全是 http:// 地址，会伤 SEO。**没有反向代理时不要开**（客户端可伪造该头）。
USE_X_FORWARDED_PROTO=False

# ---- 站点品牌（二开改名只需改这里，全站 logo/SEO/结构化数据自动跟随）----
# 站点主名称
SITE_NAME=小影音乐网
# 站点副名称：与主名称并列出现在 SEO 文案中，留空则只用主名称
SITE_NAME_ALT=热门音乐
# 可选：SEO 描述里的品牌组合短语，不填则自动按「副名（主名）」拼接
# SITE_BRAND=

# ---- 联系方式（页脚「联系我们」弹窗 / 免责声明 / 项目文档）----
# 注意：值里含 # 时必须用英文双引号包裹，否则 # 之后会被当成注释丢弃
SITE_CONTACT_EMAIL="3766849790#qq.com"
SITE_CONTACT_WECHAT=duyanbz
SITE_CONTACT_TG=xiaoying1216

# ---- 第三方统计（51.la）：留空则不输出统计脚本，建议换成自己的 ID ----
ANALYTICS_ID=3QisJxfuIZ0dJgUf

# ---- 2t58 爬虫：人机验证通过后的 PHPSESSID（浏览器获取，过期需更新）----
MUSIC_2T58_PHPSESSID=
# 源站域名清单（逗号分隔）—— 发现源站新增域名，直接往后面加就行，条数不限。
# 写法随意，下面三种都认：music.2t58.com / https://music.2t58.com / 带不带结尾斜杠
# （由 main.py 的 _normalize_base 统一规整）。
# 播放接口是加密还是明文**不用标注**，_play_url 会自动识别：返回值以 http(s) 开头
# 就按明文直链用，否则才当密文走 AES 解密。
# 某条抓不到数据会自动切下一条，失败的那条冷却 300 秒后重试（冷却期内直接跳过）。
# 留空/不填就用代码里的默认值，就是下面这两个（见 main.py 的 DOMAINS）。
# MUSIC_2T58_DOMAINS=https://www.2t58.com/,https://music.2t58.com/
# 某条域名硬失败后冷却多少秒才再试（默认 300）。
# MUSIC_2T58_DOMAIN_COOLDOWN=300
# ---- 出站源 IP（一般留空，见 README 7.5）----
# 源站会按来源 IP 拦截：机房 IP（含国内云厂商）实测会被直接拦掉，只有住宅宽带能进。
# 注意源站的封禁是**轮着来的** —— 实测这台机器的两个公网 IP 会交替被封，
# 写死任何一个都可能正好绑到被封的那个上，所以**留空交给内核挑默认出口**。
# 另外：取消一项配置不要用「删掉这一行」，重载（SIGHUP）清不掉进程里那份旧值，
# 必须写成空值（像下面这样）或真正停掉再启动。
MUSIC_2T58_SOURCE_IP=

# ---- 小影 API 基础地址（友情链接数据源，接口：{base}/api/seo/friend_links?status=true）----
# 默认 https://xiaoyingapi.com（代码里的兜底值）。私有部署时才取消注释指向自己的实例。
# XIAOYING_API_BASE=https://xiaoyingapi.com
# ---- 小影 API 签名凭证（接口要求 app_id/timestamp/nonce/sign，缺一返回 20011）----
# 在接入项目管理中创建项目后获取，属敏感信息，仅存本文件（.env 不入库）
XIAOYING_APP_ID=
XIAOYING_APP_SECRET=

# ---- 曲库：搜索结果本地化（减少回源站 2t58 的次数）----
# 搜索命中的歌曲会沉淀到本地库，同一个关键词不必反复爬；库里不够翻页时再去源站补货。
# 注意：没有"每页几条"的配置 —— 展示页与源站页一一对应，一页几条由源站决定。
# 搜索关键词的最大长度（字符，按 Unicode 字符数算，一个汉字算 1 个）：
# 输入框的 maxlength 用它，后端入库前也按它截断 —— 前后端用同一个值，
# 免得"输入框拦住了、手敲超长 URL 却能搜"这种不一致。
SEARCH_KEYWORD_MAX_CHARS=15
# 关键词保鲜时长（小时）：超过这个时间再被搜到就同步重爬一次，
# 否则库里会永远停在入库那天的内容，新歌再也进不来。
SEARCH_KEYWORD_TTL_HOURS=12
# 被屏蔽关键词的保鲜时长（小时）。屏蔽不会自愈，反复重试只是白跑，所以拉长到 7 天。
SEARCH_BLOCKED_TTL_HOURS=168
# 单次请求最多为翻页补爬几页源站；分页器页码上限也是"已爬 + 这个数"，
# 防止有人直接请求巨大页码把接口变成"按键爬虫"。
SEARCH_REFILL_MAX_PAGES=3

# ---- 热门搜索榜（header 搜索框的下拉）----
# 榜单显示几个词
HOT_SEARCH_COUNT=7
# 只统计最近多少天内被搜过的词（否则老词永久霸榜）
HOT_SEARCH_DAYS=30
# 同一个人对同一个词多少分钟内重复搜索只算一次（防刷）。0=不防刷
HOT_SEARCH_DEDUP_MINUTES=5
# 榜单结果的缓存时长（分钟）。它在每个页面的 header 里都要用，不能每次浏览都查库
HOT_SEARCH_CACHE_MINUTES=10

# ---- 每日播放榜（首页「今日热听榜」）----
# 数据来自播放页：整首播完时才 +1（中途暂停/关页面不算）
# 榜单显示几首
PLAY_RANK_COUNT=10
# 同一个人对同一首歌多少分钟内重复听完只算一次（防刷）。0=不防刷
PLAY_DEDUP_MINUTES=10

# ---- 首页「随机点唱机」（从本地曲目库随机抽）----
# 显示几首。同一批保持多久由上面的 CACHE_TTL_HOURS 决定（见 CACHE_TTL_HOURS_HOME）
RANDOM_PICK_COUNT=18

# 换库告警邮件冷却时长（小时）：写锁冲突会反复触发，没冷却会变成邮件轰炸
DB_ALERT_COOLDOWN_HOURS=24

# ---- 爬虫缓存 ----
# 全局默认缓存时长（小时），可设 1-3 或任意值
CACHE_TTL_HOURS=2
# 播放直链短缓存时长（分钟），CDN 直链有时效。
# 实测一条直链生成 73 分钟后仍可播放，默认取 60 分钟留余量；
# 调大能减少回源，但超过真实有效期就会变成"播放失败"。
CACHE_TTL_PLAY_MINUTES=60
# 按页面类型单独覆盖缓存时长（小时），不配置的页面用 CACHE_TTL_HOURS。
# 可用类型：HOME / SINGER / SONG / CHART
# 注意：搜索结果不走这里，它由本地曲库统一缓存（见上方「曲库」一段）；
#       歌手大全读本地歌手库、首页「今日热听榜」读本地播放榜，都不经过爬虫缓存。
#
# 降回源频率：源站会按来源 IP 限流，所以把歌曲页与歌手页的长缓存拉到 6 小时。
# 这两类页面的元数据（歌名、歌手、封面、歌词、曲目列表）几小时内不会变，
# 播放直链不跟着变长 —— 它有自己的短缓存（上面那条），按小时刷新。
# 榜单页保持全局的 2 小时（内容变化相对快，且只有 3 个页面）。
CACHE_TTL_HOURS_SONG=6
CACHE_TTL_HOURS_SINGER=6
