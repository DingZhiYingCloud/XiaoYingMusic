# ============================================================
# 杯子音乐网 - 环境变量配置模板
# 使用：复制本文件为 .env 后按需修改（.env 不会提交到 Git）
#       没有 .env 时程序用各配置项的默认值运行，但爬虫需要 PHPSESSID
# ============================================================

# ---- Django 核心 ----
# 密钥：生产环境请更换为随机值
SECRET_KEY=django-insecure-change-me-to-your-own-random-key
# 调试模式：True 会显示详细报错，生产环境请保持 False
DEBUG=False
# 允许访问的域名，逗号分隔（生产环境填真实域名）
ALLOWED_HOSTS=127.0.0.1
CORS_ORIGIN_ALLOW_ALL=True
# 站点跑在 HTTPS 反向代理（Nginx/CDN）后面时设为 True：
# 让 Django 信任 X-Forwarded-Proto 头，否则 canonical / og:url / sitemap.xml / robots.txt
# 里全是 http:// 地址，会伤 SEO。**没有反向代理时不要开**（客户端可伪造该头）。
USE_X_FORWARDED_PROTO=False

# ---- 站点品牌（二开改名只需改这里，全站 logo/SEO/结构化数据自动跟随）----
# 站点主名称
SITE_NAME=小影音乐网
# 站点副名称：与主名称并列出现在 SEO 文案中，留空则只用主名称
SITE_NAME_ALT=热门音乐
# 可选：SEO 描述里的品牌组合短语，不填则自动按「副名（主名）」拼接
# SITE_BRAND=

# ---- 联系方式（页脚「联系我们」弹窗 / 免责声明 / 项目文档）----
# 注意：值里含 # 时必须用英文双引号包裹，否则 # 之后会被当成注释丢弃
SITE_CONTACT_EMAIL="3766849790#qq.com"
SITE_CONTACT_WECHAT=duyanbz
SITE_CONTACT_TG=xiaoying1216

# ---- 第三方统计（51.la）：留空则不输出统计脚本，建议换成自己的 ID ----
ANALYTICS_ID=3QisJxfuIZ0dJgUf

# ---- 2t58 爬虫：人机验证的初始 PHPSESSID（可选，留空也能跑）----
# 填了能省掉第一次回源的「GET 验证页 → POST 过验证」。**过期不需要人工更新**：
# 验证失效时爬虫会自动换新会话重过一次，并把新 cookie 存进缓存（见 main.py 的
# _renew_session / _save_cookies），不用改这里、也不用重启（详见 README 7.1）。
MUSIC_2T58_PHPSESSID=
# 源站域名清单（逗号分隔）—— 发现源站新增域名，直接往后面加就行，条数不限。
# 写法随意，下面三种都认：music.2t58.com / https://music.2t58.com / 带不带结尾斜杠
# （由 main.py 的 _normalize_base 统一规整）。
# 播放接口是加密还是明文**不用标注**，_play_url 会自动识别：返回值以 http(s) 开头
# 就按明文直链用，否则才当密文走 AES 解密。
# 某条抓不到数据会自动切下一条，失败的那条冷却 120 秒后重试（冷却期内直接跳过；
# 同一组里只要有一条成功，整组冷却会立刻被清掉）。
# 留空/不填就用代码里的默认值，就是下面这两个（见 main.py 的 DOMAINS）。
# MUSIC_2T58_DOMAINS=https://www.2t58.com/,https://music.2t58.com/
# 某条源硬失败后冷却多少秒才再试（默认 120）。太长会让源站恢复后站点多空白一阵，
# 太短则每次冷却到期都要白等一次连接超时；同一组里只要有一条成功，整组冷却会立刻被清掉。
# MUSIC_2T58_DOMAIN_COOLDOWN=120
# ---- 出站源 IP（可多个，见 README 7.5）----
# 源站按**来源 IP** 封，而且实测封禁会在本机的多个公网 IP 之间**轮流**发生：
# 写死任何一个，等封禁轮到它头上整站就空白。这里列多个，被封的进冷却、自动换下一个
# （与上面那组域名是同一套切换逻辑）。写法同上，逗号分隔。
# 留空 = 不绑定源地址，交给内核挑默认出口 —— 只有一个公网 IP 的机器就该留空。
# MUSIC_2T58_SOURCE_IPS=192.253.235.28,118.107.19.79
# ---- 兜底源清单（最后一层，见 README 7.8）----
# 上面那组域名**全都**拿不到时，才会去问这里。默认 aat.cx（爱听音乐网）——
# 实测与 2t58 是同一套程序的两个版本：同一个 js/play.php、同一套榜单 id、同一套人机验证，
# 而且**机房 IP 能访问**（只拦没有 UA 的客户端）。它给的播放链接是明文直链。
# 写法同上，逗号分隔，条数不限。⚠️ 只能放**同族站点**：两站的歌曲/歌手 id 是同一套原始
# id 的两层编码，代码靠固定规则互转（见 main.py 的 _to_fallback_id），放别的站会指错歌。
# 留空/不填就用代码里的默认值（就是下面这个，见 main.py 的 FALLBACK_BASES）。
# MUSIC_2T58_FALLBACK_BASES=https://www.aat.cx/
# ---- 备用线路：代理 IP（走小影 API 的 51代理，见 README 7.9）----
# 某条源**直连**拿不到时，实时取一批代理节点对同一条源再试一遍（页面与播放接口都是），
# 第一层与兜底源都挂。为什么第一层也挂：源站是按来源 IP 封的，被封时两个域名一起直连不通，
# 这时只有代理这条路还能出数据（实测经代理访问 music.2t58.com 能过验证拿到真实页面）。
# 两条线路都失败才把该源标记冷却。
# 代理走平台接口 {XIAOYING_API_BASE}/api/ProxyIp/51daili/proxies，
# 51代理的账号三件套（uid / accessName / accessPassword）与套餐标识（packid / rid）
# 都由平台侧 .env 持有，这里**什么都不用填**；取不到时静默降级成"本次只走直连"。
# 51代理是「隧道 + 账密」模式：返回的 proxy 字段里含账密与固定网关，直接用即可，
# 不需要去它后台配 IP 白名单（也别拿 ip:port 裸连，那样连不上代理）。
# 动态代理的节点会过期，所以每次都是**实时提取、不缓存**，一次取多条逐条试（下面是条数）。
# MUSIC_2T58_PROXY_NODES=3
# ---- 回源节流与快速失败（防 502，见 README 7.10）----
# 源站封我们的根因就是回源太密，出口一封、每次回源都要等连接超时，worker 被占满 → 502。
# 出站节流：每秒最多向源站发几次（令牌桶）。⚠️ 进程内限速，全站上限 = 进程数 × 该值；0=关闭。
# MUSIC_2T58_SOURCE_QPS=2
# 领不到令牌时最多等几秒，等不到就放弃本次回源（继续排队只会把 worker 占得更久）。
# MUSIC_2T58_THROTTLE_MAX_WAIT=5
# 连接/读取超时（秒）。被封时源站是丢包，connect 会一直卡到超时，所以取小值快速失败。
# ⚠️ connect 别调大：两个出口都被封时，一次回源要把这些失败各等一遍，5 秒会吃掉 15~20 秒
# 并顶破预算（→502）；3 秒足够判定丢包，而正常回源只有几十毫秒、不受影响。
# MUSIC_2T58_CONNECT_TIMEOUT=3
# MUSIC_2T58_READ_TIMEOUT=10
# 经代理时的读取超时（秒）：代理里有一部分"连得上但不返数据"的半死节点，取小值快点换下一个
# MUSIC_2T58_PROXY_READ_TIMEOUT=6
# 一次回源（一个页面 / 一次播放信息）的总时间预算（秒），所有源与代理节点加起来算。
# ⚠️ 必须明显小于 nginx 的 60 秒，否则又会 502。
# MUSIC_2T58_REQUEST_BUDGET=25
# ---- 出站源 IP（可多个，见 README 7.5）----
# 源站按来源 IP 拦截，且封禁会在本机多个公网 IP 之间**轮流**发生（写死任一个，都可能
# 正好绑到正被封的那个上）。所以把本机公网 IP 都列出来，逗号分隔：被封的自动跳过、
# 换下一个。只有一个公网 IP 的机器留空即可（交给内核挑默认出口）。
# 另外：取消一项配置不要用「删掉这一行」，重载（SIGHUP）清不掉进程里那份旧值，
# 必须写成空值（像下面这样）或真正停掉再启动。
MUSIC_2T58_SOURCE_IPS=

# ---- 小影 API 基础地址（友情链接数据源，接口：{base}/api/seo/friend_links?status=true）----
# 默认 https://xiaoyingapi.com（代码里的兜底值）。私有部署时才取消注释指向自己的实例。
# XIAOYING_API_BASE=https://xiaoyingapi.com
# ---- 小影 API 签名凭证（接口要求 app_id/timestamp/nonce/sign，缺一返回 20011）----
# 在接入项目管理中创建项目后获取，属敏感信息，仅存本文件（.env 不入库）
XIAOYING_APP_ID=
XIAOYING_APP_SECRET=

# ---- 问题反馈中心（小影统一反馈系统，子项目零代码接入）----
# 反馈页托管在小影侧：{XIAOYING_API_BASE}/feedback/<APPID>/。
# APPID 直接复用上面的 XIAOYING_APP_ID（同一套接入项目），不需要单独配置 ——
# 线上与本地开发指的不是同一个实例、APPID 也不同，另配一个极易在一边静默失效。
# 详见 Web/services/feedback.py 顶部的接入说明。

# ---- 曲库：搜索结果本地化（减少回源站 2t58 的次数）----
# 搜索命中的歌曲会沉淀到本地库，同一个关键词不必反复爬；库里不够翻页时再去源站补货。
# 注意：没有"每页几条"的配置 —— 展示页与源站页一一对应，一页几条由源站决定。
# 搜索关键词的最大长度（字符，按 Unicode 字符数算，一个汉字算 1 个）：
# 输入框的 maxlength 用它，后端入库前也按它截断 —— 前后端用同一个值，
# 免得"输入框拦住了、手敲超长 URL 却能搜"这种不一致。
SEARCH_KEYWORD_MAX_CHARS=15
# 关键词保鲜时长（小时）：超过这个时间再被搜到就同步重爬一次，
# 否则库里会永远停在入库那天的内容，新歌再也进不来。
SEARCH_KEYWORD_TTL_HOURS=12
# 被屏蔽关键词的保鲜时长（小时）。屏蔽不会自愈，反复重试只是白跑，所以拉长到 7 天。
SEARCH_BLOCKED_TTL_HOURS=168
# 单次请求最多为翻页补爬几页源站；分页器页码上限也是"已爬 + 这个数"，
# 防止有人直接请求巨大页码把接口变成"按键爬虫"。
SEARCH_REFILL_MAX_PAGES=3

# ---- 热门搜索榜（header 搜索框的下拉）----
# 榜单显示几个词
HOT_SEARCH_COUNT=7
# 只统计最近多少天内被搜过的词（否则老词永久霸榜）
HOT_SEARCH_DAYS=30
# 同一个人对同一个词多少分钟内重复搜索只算一次（防刷）。0=不防刷
HOT_SEARCH_DEDUP_MINUTES=5
# 榜单结果的缓存时长（分钟）。它在每个页面的 header 里都要用，不能每次浏览都查库
HOT_SEARCH_CACHE_MINUTES=10

# ---- 每日播放榜（首页「今日热听榜」）----
# 数据来自播放页：整首播完时才 +1（中途暂停/关页面不算）
# 榜单显示几首
PLAY_RANK_COUNT=10
# 同一个人对同一首歌多少分钟内重复听完只算一次（防刷）。0=不防刷
PLAY_DEDUP_MINUTES=10

# ---- 播放页本地缓存 +「大家正在听」（Web/models.py 的 PlayedSong，见 README 9.1）----
# 播放页只有"这首歌还没缓存过"或"直链过期"时才回源，其余读本地表；
# 「大家正在听」也读这张表，不额外回源。
# 「大家正在听」最多显示几条（展示截断，不删数据）
PLAYED_SHOW_COUNT=60
# 「正在听」的展示窗口（分钟）：last_played_at 超过这个时间就不再显示
PLAYED_SHOW_MINUTES=30
# 直链新鲜度（分钟）：超过就当场调一次 play.php 刷新直链再交给访客（与上面的展示窗口是两个独立语义）。
# CDN 直链（酷我）实测 60~73 分钟后失效（410 Gone），所以本值必须明显小于 60，给"发出去时还活着"留余量。
PLAYED_URL_TTL_MINUTES=45
# 直链寿命（分钟）：超过它这条直链就"不敢再发"了（取下限 60）。只用于"刷新失败、拿不到新链"时兜底。
# 没有它的话，源站整条不可达期间页面会一直把过期的旧直链发出去，访客只会看到"播放链接失效"。
# ⚠️ 必须 >= PLAYED_URL_TTL_MINUTES。
PLAYED_URL_LIFESPAN_MINUTES=60
# 刷新失败后的重试间隔（分钟）：没刷到新直链时，这么久之内不再重试（避免源站不可达时每次访问都白等）
PLAYED_URL_REFRESH_RETRY_MINUTES=5
# 同步刷新的时间预算（秒）：刷新是在访客请求里等着的，必须封顶，否则源站不可达会占满 worker 导致 502
PLAYED_URL_REFRESH_BUDGET=8
# 表记录保留天数：超过就整行删掉（由播放上报顺带清理，不需要定时任务）
PLAYED_KEEP_DAYS=30
# 「大家正在听」的自动刷新间隔（秒）：播放页开久了，那块列表的时间会停在旧值、新歌也进不来，
# 前端按这个间隔去 /api/live 拉一次最新内容。只读本地表、不碰源站，可以设得比较勤；0=关闭。
PLAYED_LIVE_REFRESH_INTERVAL=120

# ---- 首页「随机点唱机」（从本地曲目库随机抽）----
# 显示几首。同一批保持多久由上面的 CACHE_TTL_HOURS 决定（见 CACHE_TTL_HOURS_HOME）
RANDOM_PICK_COUNT=18

# 换库告警邮件冷却时长（小时）：写锁冲突会反复触发，没冷却会变成邮件轰炸
DB_ALERT_COOLDOWN_HOURS=24

# ---- 爬虫缓存 ----
# 全局默认缓存时长（小时），可设 1-3 或任意值
CACHE_TTL_HOURS=2
# 播放直链短缓存时长（分钟），CDN 直链有时效。
# 实测一条直链生成 73 分钟后仍可播放，默认取 60 分钟留余量；
# 调大能减少回源，但超过真实有效期就会变成"播放失败"。
CACHE_TTL_PLAY_MINUTES=60
# 「上次成功的那份」另存副本的时长（小时）。抓不到时（源站抖动、几条源一起进冷却、
# 回源超预算）用它回落 —— 宁可给稍旧的数据，也不给空页面：榜单页空着会显示
# "暂无榜单数据"、搜索空着会显示"没找到"（后者还是错的，歌明明在库里）。
# 回落时日志里会有「回落到上次成功的那份数据」，从没成功抓到过才会显示空态。
CACHE_TTL_STALE_HOURS=24
# 按页面类型单独覆盖缓存时长（小时），不配置的页面用 CACHE_TTL_HOURS。
# 可用类型：HOME / SINGER / SONG / CHART
# 注意：搜索结果不走这里，它由本地曲库统一缓存（见上方「曲库」一段）；
#       歌手大全读本地歌手库、首页「今日热听榜」读本地播放榜，都不经过爬虫缓存。
#
# 降回源频率：源站会按来源 IP 限流，所以把歌曲页与歌手页的长缓存拉到 6 小时。
# 这两类页面的元数据（歌名、歌手、封面、歌词、曲目列表）几小时内不会变，
# 播放直链不跟着变长 —— 它有自己的短缓存（上面那条），按小时刷新。
# 榜单页保持全局的 2 小时（内容变化相对快，且只有 3 个页面）。
CACHE_TTL_HOURS_SONG=6
CACHE_TTL_HOURS_SINGER=6
